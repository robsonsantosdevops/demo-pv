# =========================================================================
# Azure Service Bus
# =========================================================================
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<policy>;SharedAccessKey=<key>

# Qual fila este processo vai consumir (definida no run/deployment).
# Valores aceitos: pedidos | oportunidades
# Os scripts em scripts/ aceitam a fila via argumento/flag, não dependem desta var.
QUEUE_NAME=pedidos

# =========================================================================
# Salesforce (cliente vendored de salesforce-admin)
# =========================================================================
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_CONSUMER_KEY=
SF_CONSUMER_SECRET=
# Opcional: login URL (default https://login.salesforce.com). Sandbox: https://test.salesforce.com
SF_LOGIN_URL=https://test.salesforce.com
# Campos extras obrigatórios da org ao criar a Account master (JSON).
# Ex. Keeggo: cnpj__c obrigatório. Ajuste conforme o schema do seu org.
SF_ACCOUNT_MASTER_EXTRA={"cnpj__c":"00000000000000"}

# =========================================================================
# SAP B1 Service Layer
# =========================================================================
# Session token B1SESSION. No cluster é injetado via env var `sessionId`
# (case-sensitive), atualizada externamente a cada ~30 min. Em dev, obter
# via POST /Login no SAP B1 Service Layer.
sessionId=
SAP_BASE_URL=https://desenvolvimento.ananim.com.br:50000/b1s/v2
SAP_COMPANY_DB=
SSL_VERIFY=false
# Demo: a Opp não carrega CardCode/itens, então o handler usa defaults.
# Ajuste para valores válidos no SAP alvo.
SAP_DEFAULT_CARDCODE=C40000
SAP_DEFAULT_ITEM_CODE=S10000
SAP_DEFAULT_BPL_ID=1

# =========================================================================
# Runtime
# =========================================================================
LOG_LEVEL=INFO
HEALTH_PORT=8080
